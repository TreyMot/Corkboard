// Nitro merges this into the wrangler.json it generates in .output/server at build time.
{
  "name": "corkboard",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "corkboard.wine", "custom_domain": true },
    // Redirected to corkboard.wine in src/server.ts.
    { "pattern": "www.corkboard.wine", "custom_domain": true },
  ],
}
